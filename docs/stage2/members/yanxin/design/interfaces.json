{
  "contractVersion": "2026-10-27",
  "owner": "闫昕",
  "baseCommit": "f1e3639b46e6b6630dbd4dbd02f9e311a6b5073b",
  "status": {
    "designReady": true,
    "executableCorePrototype": true,
    "httpImplemented": false,
    "productionPasswordAdapterImplemented": false,
    "databaseAdapterImplemented": false
  },
  "basePath": "/api/v1",
  "naming": {
    "json": "lowerCamelCase",
    "ids": "UUID string",
    "time": "UTC ISO 8601"
  },
  "schemas": {
    "RegisterRequest": {
      "username": "string; ASCII [A-Za-z0-9_]{3,24}; lowercase after validation",
      "password": "string; 12..64 code points; <=72 UTF-8 bytes; no control chars; no normalization",
      "nickname": "string; strip then 1..20 code points; no control chars"
    },
    "LoginRequest": {
      "username": "same as RegisterRequest",
      "password": "same as RegisterRequest"
    },
    "UserView": {
      "userId": "UUID string",
      "username": "canonical lowercase string",
      "nickname": "string"
    },
    "LoginResult": {
      "token": "opaque 32-byte random URL-safe base64 without padding; 43 chars",
      "expiresAt": "UTC ISO 8601",
      "user": "UserView"
    }
  },
  "authorization": {
    "header": "Authorization",
    "scheme": "Bearer",
    "singleHeaderOnly": true,
    "fallbackToDevIdentity": false,
    "tokenTtlSeconds": 28800,
    "refreshToken": false,
    "logoutScope": "current session only"
  },
  "envelope": {
    "success": {
      "code": 0,
      "message": "ok",
      "data": "endpoint-specific"
    },
    "failure": {
      "code": "integer",
      "message": "safe human-readable string",
      "data": null
    }
  },
  "errors": [
    {
      "http": 400,
      "code": 40001,
      "meaning": "参数或JSON格式错误"
    },
    {
      "http": 401,
      "code": 40101,
      "meaning": "无有效凭据或格式合法但登录失败"
    },
    {
      "http": 409,
      "code": 40901,
      "meaning": "规范用户名已存在"
    },
    {
      "http": 503,
      "code": 50301,
      "meaning": "认证依赖未装配或暂不可用"
    }
  ],
  "endpoints": [
    {
      "method": "POST",
      "path": "/auth/register",
      "authenticated": false,
      "request": "RegisterRequest",
      "response": "UserView",
      "successHttp": 200,
      "errors": [
        40001,
        40901,
        50301
      ],
      "createsSession": false
    },
    {
      "method": "POST",
      "path": "/auth/login",
      "authenticated": false,
      "request": "LoginRequest",
      "response": "LoginResult",
      "successHttp": 200,
      "errors": [
        40001,
        40101,
        50301
      ]
    },
    {
      "method": "POST",
      "path": "/auth/logout",
      "authenticated": true,
      "request": null,
      "response": {},
      "successHttp": 200,
      "errors": [
        40101,
        50301
      ],
      "knownExpiredOrRevokedToken": "idempotent success if stored; missing/cleaned token returns 401"
    },
    {
      "method": "GET",
      "path": "/users/me",
      "authenticated": true,
      "request": null,
      "response": "UserView",
      "successHttp": 200,
      "errors": [
        40101,
        50301
      ]
    }
  ],
  "strictHttpAdapterRequirements": [
    "reject unknown and duplicate JSON fields",
    "reject multiple Authorization headers",
    "request body limit",
    "never log password, token, Authorization or hashes"
  ],
  "examplesAreNonworking": true,
  "exampleUser": {
    "userId": "11111111-1111-4111-8111-111111111111",
    "username": "campus_demo",
    "nickname": "校园同学"
  }
}
