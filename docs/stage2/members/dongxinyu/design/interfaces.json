    },
    {
      "class": "edu.pkmon.study.service.StudyTaskService",
      "signature": "Optional<TaskView> currentTask(String userId)"
    },
    {
      "class": "edu.pkmon.study.service.StudyTaskService",
      "signature": "TaskView endTask(String userId, String taskId, String requestId)"
    },
    {
      "class": "edu.pkmon.study.port.TaskRepository",
