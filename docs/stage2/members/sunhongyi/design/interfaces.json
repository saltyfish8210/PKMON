{
  "owner": "sunhongyi",
  "stage": "stage2",
  "module": "capture",
  "version": "foundation-2026-10-25",
  "designedVersion": "design-2026-10-28",
  "status": "implemented_with_in_memory_store",
  "statusNote": "五个接口均已实现并通过端到端实测（2026-10-25 复测）。存储为内存替身、身份为开发期请求头替身，storageSimulated=true。开发期能力自 2026-10-25 起仅在 dev/test profile 下默认开启，其余环境关闭并返回 50301；接真库后需补 TC-07/TC-08 并把该标记置为 false。",
  "conventions": {
    "baseUrl": "http://127.0.0.1:4180",
    "businessPrefix": "/api/v1",
    "auth": "正式：Authorization: Bearer <token>（待闫昕交付）。开发/测试：X-Dev-User 请求头替身，仅在 dev/test profile 下默认开启；其他环境默认关闭，业务接口返回 50301。",
    "userIdSource": "只从 CurrentUserProvider 取得，任何接口都不接受请求体中的 userId",
    "successEnvelope": {
      "code": 0,
      "message": "ok",
      "data": {}
    },
    "errorEnvelope": {
      "code": 40001,
      "message": "参数错误",
      "data": null
    },
    "fieldCase": "lowerCamelCase",
    "timeFormat": "UTC ISO 8601（界面展示转换为北京时间）",
    "pagination": {
      "pageStartsAt": 1,
      "defaultPageSize": 20,
      "maxPageSize": 50
    }
  },
  "errorCodes": [
    {
      "code": 0,
      "httpStatus": 200,
      "meaning": "成功"
    },
    {
      "code": 40101,
      "httpStatus": 401,
      "meaning": "未提供可用的身份（开发期缺少 X-Dev-User 头）",
      "newInImplementation": true
    },
    {
      "code": 40001,
      "httpStatus": 400,
      "meaning": "参数错误，含选项不属于该题"
    },
    {
      "code": 40301,
      "httpStatus": 403,
      "meaning": "开发遭遇仅在 dev/test 开放",
      "newInImplementation": true
    },
    {
      "code": 40401,
      "httpStatus": 404,
      "meaning": "资源不存在或不属于当前用户，不泄露归属"
    },
    {
      "code": 40902,
      "httpStatus": 409,
      "meaning": "同一 requestId 内容冲突，原记录不修改"
    },
    {
      "code": 40903,
      "httpStatus": 409,
      "meaning": "该遭遇已收录，不能重复挑战",
      "newInImplementation": true
    },
    {
      "code": 41001,
      "httpStatus": 410,
      "meaning": "挑战或遭遇已过期，且该请求未曾处理"
    },
    {
      "code": 50301,
      "httpStatus": 503,
      "meaning": "认证上下文尚未接入（dev-user-header 关闭时）",
      "newInImplementation": true
    },
    {
      "code": 50302,
      "httpStatus": 503,
      "meaning": "题库暂不可用",
      "newInImplementation": true
    }
  ],
  "routeMigration": {
    "changedDemoPaths": [
      {
        "from": "POST /api/v1/capture/challenge",
        "to": "POST /api/v1/demo/capture/challenge",
        "reason": "与新正式接口路径冲突，同时注册会构成歧义映射"
      },
      {
        "from": "POST /api/v1/capture/answer",
        "to": "POST /api/v1/demo/capture/answer",
        "reason": "同上"
      }
    ],
    "unchangedDemoPaths": [
      "/api/v1/demo/sessions",
      "/api/v1/demo/state",
      "/api/v1/demo/explore",
      "/api/v1/demo/reset"
    ],
    "affectedCaller": "客户端网络层（冉昕霖）需改这两处调用，见 questions.csv Q10"
  },
  "interfaces": [
    {
      "name": "createDevSpawn",
      "method": "POST",
      "path": "/api/v1/dev/spawns",
      "implemented": true,
      "storageSimulated": true,
      "availability": "仅 dev/test profile 默认开放（或显式设置 pkmon.capture.dev-spawn-enabled=true）；其他环境返回 40301",
      "requestFields": [
        "regionId",
        "speciesId"
      ],
      "responseDataFields": [
        "spawnId",
        "regionId",
        "speciesId",
        "sourceType",
        "expiresAt"
      ],
      "enums": {
        "sourceType": [
          "DEV_SIMULATED",
          "LOCATION"
        ]
      },
      "exampleRequest": {
        "regionId": "library_entrance",
        "speciesId": "siege_lion"
      },
      "exampleResponseData": {
        "spawnId": "15dddf9e-6932-43b3-9fde-d149eb1fad38",
        "regionId": "library_entrance",
        "speciesId": "siege_lion",
        "sourceType": "DEV_SIMULATED",
        "expiresAt": "2026-10-21T13:09:39.507769700Z"
      },
      "notes": "实测返回如上（2026-10-21）。页面须依据 sourceType 标注“模拟遇见攻城狮”。遭遇机会不等于奖励，本接口不产生收录。",
      "ruleIds": [
        "BR-01"
      ]
    },
    {
      "name": "createChallenge",
      "method": "POST",
      "path": "/api/v1/capture/challenge",
      "implemented": true,
      "storageSimulated": true,
      "requestFields": [
        "spawnId"
      ],
      "responseDataFields": [
        "challengeId",
        "spawnId",
        "speciesId",
        "speciesName",
        "questionId",
        "questionText",
        "options",
        "expiresAt"
      ],
      "optionsShape": [
        {
          "optionId": "A",
          "text": "选项文本"
        }
      ],
      "exampleRequest": {
        "spawnId": "15dddf9e-6932-43b3-9fde-d149eb1fad38"
      },
      "exampleResponseData": {
        "challengeId": "60d5c1fd-52f7-4ccf-8ab7-d156557f75b8",
        "spawnId": "15dddf9e-6932-43b3-9fde-d149eb1fad38",
        "speciesId": "siege_lion",
        "speciesName": "攻城狮",
        "questionId": "hello_world_001",
        "questionText": "执行 print(\"hello world\") 之后，控制台会输出什么？",
        "options": [
          {
            "optionId": "A",
            "text": "hello world"
          },
          {
            "optionId": "B",
            "text": "\"hello world\"（连引号一起输出）"
          },
          {
            "optionId": "C",
            "text": "什么都不输出，只是定义了一个字符串"
          }
        ],
        "expiresAt": "2026-10-21T13:04:39.570979700Z"
      },
      "security": "实测响应不含 correctOptionId、answer 字段（CaptureServiceTest TC-10 断言）。",
      "errorCodes": [
        40401,
        41001,
        40903
      ],
      "notes": "同一遭遇若已有未过期的 OPEN 挑战则复用，不新建；已收录则返回 40903。",
      "ruleIds": [
        "BR-02",
        "BR-09"
      ]
    },
    {
      "name": "submitAnswer",
      "method": "POST",
      "path": "/api/v1/capture/answer",
      "implemented": true,
      "storageSimulated": true,
      "requestFields": [
        "challengeId",
        "requestId",
        "optionId"
      ],
      "responseDataFields": [
        "challengeId",
        "requestId",
        "result",
        "captureRecordId",
        "speciesId"
      ],
      "enums": {
        "result": [
          "CORRECT",
          "WRONG"
        ]
      },
      "exampleRequest": {
        "challengeId": "60d5c1fd-52f7-4ccf-8ab7-d156557f75b8",
        "requestId": "req-e2e-2",
        "optionId": "A"
      },
      "exampleResponseDataCorrect": {
        "challengeId": "60d5c1fd-52f7-4ccf-8ab7-d156557f75b8",
        "requestId": "req-e2e-2",
        "result": "CORRECT",
        "captureRecordId": "6edbb64b-9a35-4782-b073-0f1341bf8bde",
        "speciesId": "siege_lion"
      },
      "exampleResponseDataWrong": {
        "challengeId": "60d5c1fd-52f7-4ccf-8ab7-d156557f75b8",
        "requestId": "req-e2e-1",
        "result": "WRONG",
        "captureRecordId": null,
        "speciesId": "siege_lion"
      },
      "errorCodes": [
        40001,
        40401,
        40902,
        41001
      ],
      "judgementOrder": [
        "1 归属校验：challenge.userId != 当前 userId → 40401",
        "2 幂等判定：answer_attempt(user_id, request_id) 存在且内容一致 → 回放原结果；内容不同 → 40902",
        "3 有效性判定：取 spawn，再判 expiresAt 与选项合法性 → 41001 / 40001",
        "4 结算：判题；CORRECT 则写 capture_record 并置 challenge.status=CAPTURED"
      ],
      "concurrency": "当前内存替身用 ConcurrentMap.putIfAbsent 模拟唯一约束，能证明业务回查路径；真实数据库约束待依赖到位后验证（TC-07 未执行）。",
      "transactional": false,
      "transactionNote": "工程无 spring-tx，submit 尚未加事务注解；接依赖后需整体事务覆盖作答记录、收录记录与挑战状态。",
      "notes": "答错不消耗挑战，status 保持 OPEN，captureRecordId 为 null。",
      "ruleIds": [
        "BR-02",
        "BR-03",
        "BR-04",
        "BR-05",
        "BR-06",
        "BR-07",
        "BR-10"
      ]
    },
    {
      "name": "getChallengeStatus",
      "method": "GET",
      "path": "/api/v1/capture/challenges/{challengeId}",
      "implemented": true,
      "storageSimulated": true,
      "requestFields": [],
      "responseDataFields": [
        "challengeId",
        "status",
        "captureRecordId",
        "expiresAt",
        "lastAttempt"
      ],
      "lastAttemptShape": {
        "requestId": "",
        "result": "CORRECT",
        "submittedAt": "UTC ISO 8601"
      },
      "enums": {
        "status": [
          "OPEN",
          "CAPTURED",
          "EXPIRED"
        ]
      },
      "exampleResponseData": {
        "challengeId": "60d5c1fd-52f7-4ccf-8ab7-d156557f75b8",
        "status": "CAPTURED",
        "captureRecordId": "6edbb64b-9a35-4782-b073-0f1341bf8bde",
        "expiresAt": "2026-10-21T13:04:39.570979700Z",
        "lastAttempt": {
          "requestId": "req-e2e-2",
          "result": "CORRECT",
          "submittedAt": "2026-10-21T12:59:39.590867200Z"
        }
      },
      "errorCodes": [
        40401
      ],
      "notes": "只读，顺带做惰性过期落库；已处理过的请求在过期后仍可读到原结果。",
      "ruleIds": [
        "BR-06",
        "BR-07",
        "BR-08"
      ]
    },
    {
      "name": "getCollectionSummary",
      "method": "GET",
      "path": "/api/v1/collection/summary",
      "implemented": true,
      "storageSimulated": true,
      "requestFields": [],
      "responseDataFields": [
        "collectedSpeciesCount",
        "totalSpeciesCount",
        "captureCount"
      ],
      "exampleResponseData": {
        "collectedSpeciesCount": 1,
        "totalSpeciesCount": 1,
        "captureCount": 1
      },
      "notes": "totalSpeciesCount 实测为 1，来源是 FixtureCatalog 替身目录条目数；接入真实图鉴后应为实际条目数（设计样例写 3，待题库/图鉴确认）。重启后查询未执行（内存存储）。",
      "ruleIds": [
        "BR-06"
      ]
    }
  ],
